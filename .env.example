EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Só para scripts/CLI locais (migrations, seed) — NUNCA prefixar com EXPO_PUBLIC_.
SUPABASE_SECRET_KEY=

# Personal access token da conta dona DESTE projeto — só pra CLI, sempre por comando.
# NUNCA rodar `supabase login` com ele (vira sessão global e afeta outros projetos).
SUPABASE_ACCESS_TOKEN=
